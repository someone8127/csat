{
  "name": "csat-english-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "수능·모의고사 영어 리딩 학습 웹앱 (정적 사이트, GitHub Pages)",
  "scripts": {
    "build": "npm run build:data && npm run build:css",
